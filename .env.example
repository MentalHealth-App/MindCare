# Copy this file to .env and fill in your values.
# On Windows: copy .env.example .env

# MongoDB: Atlas default is mongodb+srv://... (needs DNS SRV). If you see querySrv ECONNREFUSED on Windows,
# use Atlas "standard connection" (mongodb://host1:27017,...) in MONGODB_URI_STANDARD instead.
MONGODB_URI=your_mongodb_connection_string
# MONGODB_URI_STANDARD=
# Optional: public DNS for SRV lookups (default 1.1.1.1,8.8.8.8). Use MONGODB_DNS_SERVERS=system for OS DNS only.
# MONGODB_DNS_SERVERS=

# Node backend port (default 8000)
PORT=8000

# Optional: for AI/chat features
OPENROUTER_KEY=

# Optional: JWT secret for auth (set a long random string in production)
JWT_SECRET=your_app_secret
