# Copy this file to .env and fill in your values.
# On Windows: copy .env.example .env

# MongoDB connection string (e.g. from MongoDB Atlas or local mongodb://localhost:27017)
MONGODB_URI=your_mongodb_connection_string

# Node backend port (default 8000)
PORT=8000

# Optional: for AI/chat features
OPENROUTER_KEY=

# Optional: JWT secret for auth (set a long random string in production)
JWT_SECRET=your_app_secret
